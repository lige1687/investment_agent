# Copy this file to .env and supply your own credentials locally.
DATABASE_URL=sqlite+aiosqlite:///./data/financial.db
SECRET_KEY=replace-with-a-random-secret-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ANTHROPIC_API_KEY=sk-your-anthropic-api-key
THS_API_BASE_URL=http://127.0.0.1:8000
# live (default) fails closed when a real source is unavailable.
# demo explicitly enables generated data and labels every response as mock.
MARKET_DATA_MODE=live
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token
YANGJIBAO_API_BASE_URL=http://127.0.0.1:8000
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
